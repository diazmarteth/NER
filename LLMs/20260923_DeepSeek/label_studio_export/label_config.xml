<View>
  <Header value="$doc_id — page $page"/>
  <View style="display: flex;">
    <View style="flex: 1; padding-right: 10px;">
      <Image name="page_image" value="$image" zoom="true" zoomControl="true" rotateControl="true" width="100%"/>
    </View>
    <View style="flex: 1; max-height: 800px; overflow-y: auto;">
      <Text name="text" value="$text"/>
    </View>
  </View>

  <Labels name="label" toName="text">
    <Label value="PER" background="#e6194B"/>
    <Label value="PLACE" background="#3cb44b"/>
    <Label value="OBJ" background="#4363d8"/>
    <Label value="VIS" background="#f58231"/>
    <Label value="ICO" background="#911eb4"/>
    <Label value="DATE" background="#42d4f4"/>
    <Label value="GROUP" background="#f032e6"/>
  </Labels>

  <Relations>
    <Relation value="created"/>
    <Relation value="attributed_to"/>
    <Relation value="has_geographic_epithet"/>
    <Relation value="has_patron"/>
    <Relation value="happened_in_date"/>
    <Relation value="has_lifespan"/>
    <Relation value="was_restored_in"/>
    <Relation value="has_current_location"/>
    <Relation value="has_original_location"/>
    <Relation value="worked_in"/>
    <Relation value="born_in"/>
    <Relation value="died_in"/>
    <Relation value="influenced_by"/>
    <Relation value="collaborated_with"/>
    <Relation value="married_to"/>
    <Relation value="student_of"/>
    <Relation value="teacher_of"/>
    <Relation value="owned_by"/>
    <Relation value="depicts"/>
    <Relation value="decorated_with"/>
    <Relation value="carries_inscription"/>
    <Relation value="part_of"/>
  </Relations>

  <Collapse>
    <Panel value="Raw OCR text (uncorrected) — reference only">
      <Text name="raw_text_display" value="$raw_text"/>
    </Panel>
  </Collapse>
</View>
